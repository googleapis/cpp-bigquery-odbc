package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])  # Apache 2.0

load(":odbc_client_interface.bzl", "odbc_client_interface_hdrs", "odbc_client_interface_srcs")

cc_library(
    name = "odbc_client_interface",
    srcs = odbc_client_interface_srcs,
    hdrs = odbc_client_interface_hdrs,
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_cloud_cpp//:experimental-bigquery-rest",
        "//:google_cloud_odbc_bq_driver_internal",
])

[cc_test(
    name = client_interface_test.replace("/", "_").replace(".cc", ""),
    srcs = [client_interface_test],
    tags = ["unit-tests"],
    deps = [
        "//:odbc_client_interface",
        "@com_google_googletest//:gtest_main",
        "//google/cloud/odbc/integration_tests/testing_util:cpp_bigquery_odbc_integration_testing_util",
    ],
) for client_interface_test in glob(["*_test.cc"])]
