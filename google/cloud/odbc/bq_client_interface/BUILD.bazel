package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])  # Apache 2.0

load(":odbc_bq_client_interface.bzl", "odbc_bq_client_interface_hdrs", "odbc_bq_client_interface_srcs")

cc_library(
    name = "odbc_bq_client_interface",
    srcs = odbc_bq_client_interface_srcs,
    hdrs = odbc_bq_client_interface_hdrs,
    visibility = ["//visibility:public"],
    deps = [
        "//google/cloud/odbc/internal:odbc_internal",
        "@com_google_cloud_cpp//:bigquery",
        "@com_google_cloud_cpp//:experimental-bigquery-rest",
        "@com_google_cloud_cpp//:oauth2",
        "@google_cloud_cpp//:resourcemanager",
    ],
)

[cc_test(
    name = bq_client_interface_test.replace("/", "_").replace(".cc", ""),
    srcs = [bq_client_interface_test],
    tags = ["unit-tests"],
    deps = [
        "//:odbc_bq_client_interface",
        "//google/cloud/odbc/testing:google_cloud_odbc_testing_utils",
        "@com_google_cloud_cpp//:bigquery_mocks",
        "@com_google_cloud_cpp//:experimental-bigquery-rest_mocks",
        "@com_google_cloud_cpp//:mocks",
        "@com_google_googletest//:gtest_main",
    ],
) for bq_client_interface_test in glob(["*_test.cc"])]
