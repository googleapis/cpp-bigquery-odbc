licenses(["notice"])  # Apache v2

package(default_visibility = ["//visibility:private"])

# Define a config_setting for Windows
config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

# Library and tests for Driver internal
load(":google_cloud_odbc_bq_driver_internal.bzl", "google_cloud_odbc_bq_driver_internal_hdrs", "google_cloud_odbc_bq_driver_internal_srcs")

cc_library(
    name = "google_cloud_odbc_bq_driver_internal",
    srcs = google_cloud_odbc_bq_driver_internal_srcs + select({
        ":windows": [
            "bq_driver/internal/driver_form.cc",
            "bq_driver/internal/driver_log_form.cc",
            "bq_driver/internal/driver_form_proxy.cc",
            "bq_driver/internal/driver_adv_opt_form.cc",
        ],
        "//conditions:default": [],
    }),
    hdrs = google_cloud_odbc_bq_driver_internal_hdrs + select({
        ":windows": [
            "bq_driver/internal/driver_form.h",
            "bq_driver/internal/driver_log_form.h",
            "bq_driver/internal/driver_form_proxy.h",
            "bq_driver/internal/driver_adv_opt_form.h",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//:__pkg__"],
    deps = [
        "//google/cloud/odbc/bq_client_interface:odbc_bq_client_interface",
        "//google/cloud/odbc/internal:odbc_internal",
        "@com_google_cloud_cpp//:experimental-bigquery-rest",  # We need this dependency to use 'options' from client libraries
    ],
)

[cc_test(
    name = driver_internal_utils_test.replace("/", "_").replace(".cc", ""),
    srcs = select({
        # Includes all test files on Windows. Excludes `driver_form_test.cc` and
        # `driver_log_form_test.cc` on non-Windows platforms to avoid compatibility
        # issues with platform-specific features like UI components.
        ":windows": [driver_internal_utils_test],
        "//conditions:default": [] if driver_internal_utils_test.endswith(("driver_form_test.cc", "driver_log_form_test.cc", "driver_form_proxy_test.cc")) else [],
    }),
    tags = ["unit-tests"],
    deps = [
        "//google/cloud/odbc/testing:google_cloud_odbc_testing_bq_driver_utils",
        "//google/cloud/odbc/testing:google_cloud_odbc_testing_utils",
        "@com_google_googletest//:gtest_main",
    ],
) for driver_internal_utils_test in glob(["bq_driver/internal/*_test.cc"])]

# Library target for the Driver

load(":google_cloud_odbc_bq_driver.bzl", "google_cloud_odbc_bq_driver_hdrs", "google_cloud_odbc_bq_driver_srcs")

cc_library(
    name = "google_cloud_odbc_bq_driver",
    srcs = google_cloud_odbc_bq_driver_srcs,
    hdrs = google_cloud_odbc_bq_driver_hdrs,
    visibility = ["//:__subpackages__"],
    deps = [
        "//:google_cloud_odbc_bq_driver_internal",
    ],
)

[cc_test(
    name = driver_utils_test.replace("/", "_").replace(".cc", ""),
    srcs = select({
        ":windows": [driver_utils_test],
        "//conditions:default": [driver_utils_test] if not driver_utils_test.endswith("odbc_windows_test.cc") else [],
    }),
    tags = ["unit-tests"],
    deps = [
        "//google/cloud/odbc/testing:google_cloud_odbc_testing_bq_driver_utils",
        "//google/cloud/odbc/testing:google_cloud_odbc_testing_utils",
        "@com_google_googletest//:gtest_main",
    ],
) for driver_utils_test in glob(["bq_driver/*_test.cc"])]
