filegroup(
    name = "hdrs",
    srcs = glob([
        "testing/*.h",
    ]),
)

filegroup(
    name = "srcs",
    srcs = glob([
        "testing/*.cc",
        "tests/*.cc",
    ]),
)

cc_test(
  name = "odbc_tests",
  srcs = [
    ":hdrs",
    ":srcs",
  ],
  copts = [
    "-std=c++17",
    "-I$(IODBC_INCLUDE_PATH)"
  ],
  deps = [
    "@system_libs//:odbc_driver_manager",
    "@com_google_googletest//:gtest_main",
  ],
)
