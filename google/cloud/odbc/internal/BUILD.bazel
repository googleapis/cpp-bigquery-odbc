package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])  # Apache 2.0

load(":odbc_internal.bzl", "odbc_internal_hdrs", "odbc_internal_srcs")

# Generate version.h from version.h.in
genrule(
    name = "generate_version_h",
    srcs = ["version.h.in"],
    outs = ["version.h"],
    # VERSION comes either from a .bzl file or a Bazel define
    cmd = "sed 's,@FULL_VERSION@,$(VERSION),g' $< > $@",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "odbc_internal",
    srcs = odbc_internal_srcs,
    hdrs = odbc_internal_hdrs + [":generate_version_h"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_cloud_cpp//:experimental-bigquery-rest",
    ],
)

[cc_test(
    name = odbc_internal_test.replace("/", "_").replace(".cc", ""),
    srcs = [odbc_internal_test],
    tags = ["unit-tests"],
    deps = [
        "//:odbc_internal",
        "@com_google_googletest//:gtest_main",
    ],
) for odbc_internal_test in glob(["*_test.cc"])]
