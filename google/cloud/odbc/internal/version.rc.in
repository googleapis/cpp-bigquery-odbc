#include <winver.h>
#include <windows.h>

1 VERSIONINFO
 FILEVERSION @DRIVER_VERSION_RC@
 PRODUCTVERSION @DRIVER_VERSION_RC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Google Inc"
            VALUE "FileDescription",  "BigQuery ODBC Driver"
            VALUE "FileVersion",      "@DRIVER_VERSION@"
            VALUE "ProductName",      "BigQuery ODBC Driver"
            VALUE "ProductVersion",   "@DRIVER_VERSION@"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
