<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Fragment>
        <!-- Product Components -->
        <ComponentGroup Id="ProductComponents">
            <ComponentRef Id="DriverFilesComponent" />
            <ComponentRef Id="ODBCRegistrySettings" />
            <ComponentRef Id="InstallerIconComponent"/>
            <ComponentRef Id="DeleteDSNScriptComponent" />
        </ComponentGroup>

<CustomAction Id="RemoveAllDriverDSNs"
              Directory="AssetsFolder"
              ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File delete_dsns_all_users.ps1"
              Execute="deferred"
              Impersonate="no"
              Return="ignore"/>

<InstallExecuteSequence>
  <Custom Action="RemoveAllDriverDSNs" Before="RemoveFiles">REMOVE="ALL"</Custom>
</InstallExecuteSequence>
        <DirectoryRef Id="INSTALLFOLDER" FileSource="..\files\$(var.Platform)\Release">

            <!-- Combined Driver Files Component -->
            <Component Id="DriverFilesComponent" Guid="0b6e6271-38da-4c8c-8897-f675ff1e702d">
                <File Id="google_cloud_odbc_bq_driver.dll" Name="google_cloud_odbc_bq_driver.dll" />
            </Component>

                <Directory Id="AssetsFolder" Name="assets">
                    <Component Id="InstallerIconComponent" Guid="*">
                        <File Id="InstallerIconFile"
                              Name="bq.ico"
                              Source="$(var.ProjectDir)\Assets\bq.ico"
                              KeyPath="yes" />
                    </Component>

                    <Component Id="DeleteDSNScriptComponent" Guid="*">
                        <File Id="DeleteDSNScript"
                            Name="delete_dsns_all_users.ps1"
                            Source="$(var.ProjectDir)\Assets\delete_dsns_all_users.ps1"
                            KeyPath="yes" />
                    </Component>
                </Directory>

            <Component Id="CreateAndRemoveFolder" Guid="*">
                <CreateFolder />
                <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Component Id="ODBCRegistrySettings" Guid="*">
                <!-- ODBC Data Sources -->
                <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBC.INI\ODBC Data Sources" Name="[DSNNAME]" Type="string" Value="!(loc.DriverName)" />
                <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\ODBC\ODBC.INI\[DSNNAME]" Action="removeOnUninstall" />

                <!-- Additional Google-specific registry entries -->
                <RegistryKey Root="HKLM" Key="SOFTWARE\Google\ODBC Driver for Google BigQuery\Driver">
                     <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
                </RegistryKey>
                <RemoveRegistryKey Root="HKLM"
                                   Key="SOFTWARE\Google\ODBC Driver for Google BigQuery\Driver"
                                   Action="removeOnUninstall" />

                
                <!-- DSN Configuration -->
                <RegistryKey Root="HKLM" Key="SOFTWARE\ODBC\ODBC.INI\[DSNNAME]">
                    <RegistryValue Name="Description" Type="string" Value="!(loc.DriverName)" />
                    <RegistryValue Name="Catalog" Type="string" Value="" />
                    <RegistryValue Name="Driver" Type="string" Value="!(loc.DriverName)" />
                    <RegistryValue Name="SQLDialect" Type="string" Value="1" />
                    <RegistryValue Name="OAuthMechanism" Type="string" Value="1" />
                    <RegistryValue Name="Min_TLS" Type="string" Value="1.2" />
                    <RegistryValue Name="AllowLargeResults" Type="string" Value="0" />
                    <RegistryValue Name="LargeResultsDataSetId" Type="string" Value="_odbc_temp_tables" />
                    <RegistryValue Name="LargeResultsTempTableExpirationTime" Type="string" Value="3600000" />
                </RegistryKey>

                <!-- ODBC Drivers -->
                <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers" Name="!(loc.DriverName)" Type="string" Value="Installed" />

                <!-- ODBC Driver Configuration -->
                <RegistryKey Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\!(loc.DriverName)">
                    <RegistryValue Name="Description" Type="string" Value="!(loc.DriverName)" />
                    <RegistryValue Name="Driver" Type="string" Value="[INSTALLFOLDER]!(loc.DLLName).dll" />
                    <RegistryValue Name="Setup" Type="string" Value="[INSTALLFOLDER]!(loc.DLLName).dll" />
                </RegistryKey>

  <RemoveRegistryKey Root="HKLM"
                     Key="SOFTWARE\ODBC\ODBCINST.INI\!(loc.DriverName)"
                     Action="removeOnUninstall" />
            </Component>
        </DirectoryRef>
    </Fragment>

</Wix>
