{
  "extends": [
    "config:base",
    "docker:disable",
    "schedule:weekdays"
  ],
  "python": {
    "enabled": true
  },
  "baseBranches": [
    "main"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^ci/etc/vcpkg-version.txt$"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9]{4}\\.[0-9]{2}\\.[0-9]{2})$"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "microsoft/vcpkg",
      "versioningTemplate": "loose"
    },
    {
      "fileMatch": [
        "^google/cloud/odbc/CMakeLists.txt$"
      ],
      "matchStrings": [
        "URL \"https://github.com/(?<depName>.*?)/archive/.*?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\.tar\\.gz\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "abseil/abseil-cpp",
        "com_google_absl"
      ],
      "groupName": "Abseil"
    },
    {
      "matchPackageNames": [
        "protocolbuffers/protobuf",
        "com_google_protobuf"
      ],
      "groupName": "Protobuf"
    }
  ]
}
